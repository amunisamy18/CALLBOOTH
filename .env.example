PORT=3000

# STUN server (free, no credentials needed)
STUN_URL=stun:stun.l.google.com:19302

# TURN server (required for cross-network calls across different NAT/firewalls)
# Get free TURN credentials at: https://www.metered.ca/tools/openrelay/ or use coturn
# Without TURN, video calls may fail on different networks (e.g., different home WiFi)
TURN_URL=
TURN_USER=
TURN_PASS=

# Set to 1 when behind HTTPS (marks the session cookie Secure)
# Required for production! Camera access requires HTTPS except on localhost.
SECURE_COOKIE=0

# Maximum photo rounds per booth session (1-6)
MAX_ROUNDS=6

# Data persistence (flat-file, no Supabase needed)
# DATA_FILE=./data.json
# MEDIA_DIR=./media
